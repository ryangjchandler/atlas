#!/usr/bin/env bash
# Prepares an Amp orb (Debian 12) for this Laravel + Inertia/React app.
# Idempotent: safe to rerun on a warm snapshot.
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."

step() {
  local name="$1"
  shift
  local start=$SECONDS
  echo "==> $name"
  "$@"
  echo "<== $name ($((SECONDS - start))s)"
}

PHP_VERSION=8.4
PHP_PACKAGES=(
  "php$PHP_VERSION-cli" "php$PHP_VERSION-bcmath" "php$PHP_VERSION-curl"
  "php$PHP_VERSION-intl" "php$PHP_VERSION-mbstring" "php$PHP_VERSION-mysql"
  "php$PHP_VERSION-sqlite3" "php$PHP_VERSION-xml" "php$PHP_VERSION-zip"
)

# Local-only development database; the server listens on localhost only.
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=password

install_php() {
  local missing=()
  for pkg in "${PHP_PACKAGES[@]}" unzip; do
    dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed' || missing+=("$pkg")
  done
  if [ ${#missing[@]} -eq 0 ]; then
    echo "PHP packages already installed"
    return
  fi

  # Debian 12 ships PHP 8.2; the lockfile needs >= 8.4.1, so use the Sury repository.
  if [ ! -f /etc/apt/sources.list.d/php.list ]; then
    sudo apt-get update -q
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q ca-certificates curl
    sudo curl -fsSL -o /usr/share/keyrings/deb.sury.org-php.gpg https://packages.sury.org/php/apt.gpg
    echo "deb [signed-by=/usr/share/keyrings/deb.sury.org-php.gpg] https://packages.sury.org/php/ bookworm main" |
      sudo tee /etc/apt/sources.list.d/php.list >/dev/null
  fi
  sudo apt-get update -q
  sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q --no-install-recommends "${missing[@]}"
}

install_composer() {
  if command -v composer >/dev/null; then
    echo "composer $(composer --version 2>/dev/null | awk '{print $3}') already installed"
    return
  fi
  local tmp
  tmp="$(mktemp -d)"
  curl -fsSL -o "$tmp/composer-setup.php" https://getcomposer.org/installer
  local expected actual
  expected="$(curl -fsSL https://composer.github.io/installer.sig)"
  actual="$(php -r "echo hash_file('sha384', '$tmp/composer-setup.php');")"
  if [ "$expected" != "$actual" ]; then
    echo "Composer installer checksum mismatch" >&2
    exit 1
  fi
  sudo php "$tmp/composer-setup.php" --quiet --install-dir=/usr/local/bin --filename=composer
  rm -rf "$tmp"
}

install_mysql() {
  if ! dpkg-query -W -f='${Status}' mysql-server 2>/dev/null | grep -q 'install ok installed'; then
    # Debian 12's default-mysql-server is MariaDB; use Oracle's repository for MySQL 8.4 LTS.
    if [ ! -f /etc/apt/sources.list.d/mysql.list ]; then
      curl -fsSL https://repo.mysql.com/RPM-GPG-KEY-mysql-2025 |
        sudo gpg --batch --yes --dearmor -o /usr/share/keyrings/mysql.gpg
      echo "deb [signed-by=/usr/share/keyrings/mysql.gpg] http://repo.mysql.com/apt/debian bookworm mysql-8.4-lts" |
        sudo tee /etc/apt/sources.list.d/mysql.list >/dev/null
    fi
    sudo apt-get update -q
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y -q mysql-server
  fi

  # Disposable orb database: favour speed over durability.
  local cnf=/etc/mysql/conf.d/zz-orb.cnf
  local wanted='[mysqld]
bind-address = 127.0.0.1
skip-log-bin
innodb_flush_log_at_trx_commit = 0
innodb_doublewrite = 0
sync_binlog = 0'
  if [ "$(cat "$cnf" 2>/dev/null)" != "$wanted" ]; then
    echo "$wanted" | sudo tee "$cnf" >/dev/null
    sudo systemctl restart mysql
  fi
  sudo systemctl enable --now mysql

  sudo mysql <<SQL
CREATE DATABASE IF NOT EXISTS \`$DB_DATABASE\`;
CREATE USER IF NOT EXISTS '$DB_USERNAME'@'localhost' IDENTIFIED BY '$DB_PASSWORD';
CREATE USER IF NOT EXISTS '$DB_USERNAME'@'127.0.0.1' IDENTIFIED BY '$DB_PASSWORD';
GRANT ALL PRIVILEGES ON \`$DB_DATABASE\`.* TO '$DB_USERNAME'@'localhost', '$DB_USERNAME'@'127.0.0.1';
SQL
}

# Set KEY=value in .env, replacing an existing or commented-out entry.
set_env() {
  if grep -Eq "^#? *$1=" .env; then
    sed -Ei "s|^#? *$1=.*|$1=$2|" .env
  else
    echo "$1=$2" >>.env
  fi
}

prepare_env() {
  [ -f .env ] || cp -- .env.example .env
  grep -q '^APP_KEY=base64:' .env || php artisan key:generate --ansi --no-interaction
  set_env DB_CONNECTION mysql
  set_env DB_HOST 127.0.0.1
  set_env DB_PORT 3306
  set_env DB_DATABASE "$DB_DATABASE"
  set_env DB_USERNAME "$DB_USERNAME"
  set_env DB_PASSWORD "$DB_PASSWORD"
  php artisan migrate --force --no-interaction
}

step "Install PHP $PHP_VERSION" install_php
step "Install MySQL" install_mysql
step "Install Composer" install_composer
step "composer install" composer install --no-interaction --no-progress --prefer-dist
step "npm ci" npm ci --no-audit --no-fund
step "Prepare .env and database" prepare_env
step "Build frontend assets" npm run build

echo "Setup complete"
